# 1단계: ARM64 아키텍처용 빌드 환경 구성 (이름: builder)
# Docker의 buildx가 QEMU를 통해 이 단계를 x86 머신에서 에뮬레이션합니다.
FROM arm64v8/ros:humble-ros-base AS builder

# ARM64 환경 내에 필요한 시스템 패키지를 설치합니다.
RUN apt-get update && apt-get install -y \
    can-utils \
    git \
    vim \
    libboost-all-dev \
    iproute2 \
    ros-dev-tools \
    && rm -rf /var/lib/apt/lists/*

# ROS 2 작업 공간을 생성합니다.
WORKDIR /ros2_ws

# 소스 코드를 빌드 환경으로 복사합니다.
COPY . /ros2_ws/

# ARM64 환경에서 네이티브처럼 의존성을 설치하고 소스 코드를 빌드합니다.
# --symlink-install 옵션을 제거하여 실제 파일을 install 폴더에 복사합니다.
RUN . /opt/ros/humble/setup.sh && \
    rosdep update && \
    rosdep install -i --from-path src --rosdistro humble -y --skip-keys "motor_driver" && \
    colcon build

# 2단계: 결과물만 담을 최종 이미지
# scratch는 CMD가 없어 create가 실패하므로, 최소한의 셸을 가진 busybox를 사용합니다.
FROM busybox:latest
COPY --from=builder /ros2_ws/install /install_arm64
# 이 이미지는 파일을 담는 용도이므로, CMD는 특별한 의미가 없습니다.
CMD ["echo", "This is an artifact container. Use 'docker cp' to extract files."]

